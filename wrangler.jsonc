{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spanish-teacher-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // 하루 1회, 낮 12시(KST) = 03:00 UTC. (2026-09-01, 3시간 간격에서 변경)
  // 발송 뒤 GitHub Actions(daily-clip.yml)가 그 문장이 나오는 유튜브 클립을
  // 찾아 영상으로 뒤따라 보낸다.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spanish-teacher-bot-db",
      "database_id": "placeholder"
    }
  ],

  "vars": {
    // 안내 문구 전용 — 실제 발송은 위 crons 가 한다(하루 1회 낮 12시).
    // 24 이상이면 문구가 "하루 한 번 낮 12시에" 로 바뀐다 (format.js cycleText).
    "INTERVAL_HOURS": "24",
    "TIMEZONE": "Asia/Seoul",
    "QUIET_ENABLED": "true",
    "QUIET_START_HOUR": "0",
    "QUIET_END_HOUR": "7",
    // TTS mp3 는 그만 보낸다 — 대신 실제 영화·드라마 클립 영상이 따라간다
    // (daily-clip.yml). 영상 쪽이 죽었을 때 되살리려면 "true" 로.
    "SEND_VOICE": "false",
    "SHOW_SPANISH": "false",
    // 발음 음성 속도. "+0%" 가 원어민 보통 속도.
    // 더 빠르게: "+15%" ~ "+30%" / 더 천천히: "-15%"
    "VOICE_RATE": "+0%",
    // es-MX-DaliaNeural(중남미·여성) 또는 es-MX-JorgeNeural(중남미·남성)
    // 스페인 본토 발음을 원하면 es-ES-ElviraNeural(여성) / es-ES-AlvaroNeural(남성)
    // (본토는 c/z 를 영어 th 처럼 발음해 한글 표기와 다르게 들릴 수 있음)
    "VOICE_NAME": "es-MX-DaliaNeural"
  }
}
